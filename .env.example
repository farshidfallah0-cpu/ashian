# ─────────────────────────────────────────────────────────────
# آشیان — متغیرهای محیطی
# این فایل را به .env کپی کنید. همه‌ی برنامه‌ها همین یک فایل را می‌خوانند
# و موقع اجرا با Zod اعتبارسنجی می‌شوند.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# lite = بدون Docker (PGlite، کش/صف/جستجوی داخل حافظه، فایل محلی)
# full = PostgreSQL، Redis، Typesense و S3 واقعی (docker compose up -d)
INFRA_MODE=lite

# ── آدرس‌ها ──
WEB_URL=http://localhost:3000
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ── دیتابیس ──
# lite: سرور PGlite محلی روی پورت 54329 (با pnpm dev خودکار بالا می‌آید)
# full: از طریق PgBouncer → postgres://ashian:ashian@localhost:6432/ashian
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# اختیاری: replica فقط‌خواندنی؛ اگر خالی باشد از DATABASE_URL خوانده می‌شود
DATABASE_REPLICA_URL=
# اختیاری: آدرس مستقیم Postgres (بدون PgBouncer) فقط برای migration و seed
DATABASE_MIGRATE_URL=
DATABASE_POOL_MAX=10
LITE_DB_DIR=.data/pglite

# ── Redis (فقط حالت full) ──
REDIS_URL=redis://localhost:6379

# ── Typesense (فقط حالت full) ──
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=ashian-dev-key

# ── فایل ──
# حالت full: MinIO/S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=me-central-1
S3_BUCKET=ashian-media
S3_ACCESS_KEY=ashian
S3_SECRET_KEY=ashian-dev-secret
S3_PUBLIC_URL=http://localhost:9000/ashian-media
# حالت lite: پوشه‌ی محلی
STORAGE_LOCAL_DIR=.data/uploads
# امضای آدرس‌های آپلود مستقیم
MEDIA_SIGNING_SECRET=change-me-media-signing-secret-32-chars

# ── محدودیت نرخ درخواست ──
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# ── احراز هویت ──
# دامنه‌ی کوکی نشست؛ مثلاً .ashian.ae (خالی = همان هاست)
COOKIE_DOMAIN=
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# ── سرویس‌های بیرونی (قابل تعویض) ──
SMS_PROVIDER=console
PAYMENT_PROVIDER=mock

# ── فرانت (در مرورگر هم در دسترس است) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
