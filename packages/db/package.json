{
  "name": "@ashian/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lite-server": "node dist/lite-server.js",
    "generate": "drizzle-kit generate",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed/run.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ashian/infra": "workspace:*",
    "@ashian/shared": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-postgis": "^0.2.8",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@ashian/config": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
